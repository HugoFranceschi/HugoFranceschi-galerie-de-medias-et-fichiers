# Les fichiers déposés ne doivent jamais être exécutés par PHP.
Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar .phps .cgi .pl .py .sh
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|phps|cgi|pl|py|sh|html?|svg)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|phps|cgi|pl|py|sh|html?|svg)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
